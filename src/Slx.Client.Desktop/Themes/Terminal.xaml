<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- Site themes.css data-theme='mono' (2026-10-23): black and white, square corners, mono voice, no acid accent. -->
 <SolidColorBrush x:Key="Background" Color="#000000"/><SolidColorBrush x:Key="Surface" Color="#0C0C0C"/>
 <SolidColorBrush x:Key="SurfaceRaised" Color="#161616"/><SolidColorBrush x:Key="SurfaceHover" Color="#161616"/>
 <SolidColorBrush x:Key="SurfaceInset" Color="#050505"/><SolidColorBrush x:Key="ControlFill" Color="#0E0E0E"/>
 <SolidColorBrush x:Key="ControlInset" Color="#080808"/><SolidColorBrush x:Key="Border" Color="#2B2B2B"/>
 <SolidColorBrush x:Key="ControlBorder" Color="#7D7D7D"/><SolidColorBrush x:Key="ButtonBorder" Color="#555555"/>
 <SolidColorBrush x:Key="ControlHoverBorder" Color="#A3A3A3"/><SolidColorBrush x:Key="ControlHighlight" Color="#0AFFFFFF"/>
 <SolidColorBrush x:Key="Text" Color="#EDEDED"/><SolidColorBrush x:Key="Muted" Color="#9C9C9C"/>
 <SolidColorBrush x:Key="Accent" Color="#F2F2F2"/><SolidColorBrush x:Key="AccentHover" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AccentText" Color="#000000"/><SolidColorBrush x:Key="AccentWash" Color="#0DFFFFFF"/>
 <SolidColorBrush x:Key="AccentWashStrong" Color="#17FFFFFF"/><SolidColorBrush x:Key="AccentLine" Color="#73FFFFFF"/>
 <SolidColorBrush x:Key="Success" Color="#D9D9D9"/><SolidColorBrush x:Key="SuccessWash" Color="#0AFFFFFF"/>
 <SolidColorBrush x:Key="Danger" Color="#FF9B9B"/><SolidColorBrush x:Key="DangerWash" Color="#12FF9B9B"/>
 <SolidColorBrush x:Key="DangerLine" Color="#66FF9B9B"/>
 <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="1,0.8"><GradientStop Color="#EB101010" Offset="0"/><GradientStop Color="#E6000000" Offset="0.52"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#3DEDEDED" Offset="0"/><GradientStop Color="#2BEDEDED" Offset="0.12"/></LinearGradientBrush>
 <LinearGradientBrush x:Key="SignalSurface" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EB141414" Offset="0"/><GradientStop Color="#E8080808" Offset="0.6"/></LinearGradientBrush>
 <SolidColorBrush x:Key="Backdrop" Color="#CC000000"/><Color x:Key="ShadowColor">#000000</Color>
 <SolidColorBrush x:Key="ScrollThumb" Color="#5C5C5C"/><SolidColorBrush x:Key="ScrollThumbHover" Color="#9A9A9A"/>
 <SolidColorBrush x:Key="AmbientFace" Color="#8C8C8C"/><SolidColorBrush x:Key="AmbientEdge" Color="#D4D4D4"/>
 <FontFamily x:Key="FontText">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
 <FontFamily x:Key="FontDisplay">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
 <FontFamily x:Key="FontUi">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
 <FontWeight x:Key="DisplayWeight">SemiBold</FontWeight>
 <CornerRadius x:Key="ControlRadius">0</CornerRadius><CornerRadius x:Key="PanelRadius">0</CornerRadius>
 <CornerRadius x:Key="SmallRadius">0</CornerRadius><CornerRadius x:Key="ThumbRadius">0</CornerRadius>
</ResourceDictionary>
