<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib">
 <!-- Site controls.css / primitives.css mapped to native WPF. Colors, faces and radii are theme tokens (Olive/Terminal.xaml).
      Hover/press/focus never change geometry: they fade dedicated layers (p:Motion.FadeTo) or nudge content (p:Motion.ShiftY). -->
 <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">12</sys:Double>
 <p:ApplicationIconConverter x:Key="ApplicationIcon"/>
 <DataTemplate x:Key="ProfileNameTemplate"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" ToolTip="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate>
 <BooleanToVisibilityConverter x:Key="VisibleWhen"/><Style TargetType="UserControl"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
 <Style TargetType="Window"><Setter Property="Background" Value="{DynamicResource Background}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="{DynamicResource FontText}"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/><Setter Property="TextOptions.TextRenderingMode" Value="Grayscale"/></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <!-- Typography roles: reading text (FontText), interface voice for labels/controls/data (FontUi), display headings (FontDisplay). -->
 <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="LineHeight" Value="23"/></Style>
 <Style x:Key="MonoLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="{DynamicResource DisplayWeight}"/><Setter Property="LineHeight" Value="38"/><Setter Property="Margin" Value="0,8,0,10"/></Style>
 <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}"><Setter Property="FontSize" Value="17"/></Style>
 <Style x:Key="DataValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
 <Style x:Key="StepNumber" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}"><Setter Property="FontSize" Value="12"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Top"/></Style>
 <!-- Icons move only on interaction (site icon-motion.css): a 2px nudge toward the action, no autonomous loop. -->
 <Style x:Key="NavIcon" TargetType="Path"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="SnapsToDevicePixels" Value="True"/>
  <Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="p:Motion.ShiftX" Value="2"/></DataTrigger></Style.Triggers></Style>
 <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="FontFamily" Value="{DynamicResource FontText}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,8"/><Setter Property="MaxWidth" Value="360"/></Style>
 <Style x:Key="KeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Rectangle Stroke="{DynamicResource Accent}" StrokeThickness="2" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True" IsHitTestVisible="False"/></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="PrimaryKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Grid IsHitTestVisible="False"><Rectangle Stroke="{DynamicResource Accent}" StrokeThickness="2" RadiusX="5" RadiusY="5"/><Rectangle Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" StrokeDashArray="2,1" Margin="3" SnapsToDevicePixels="True"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <!-- Buttons: secondary (default), PrimaryButton (action), LinkButton (quiet/ghost), DangerButton. -->
 <Style TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
  <Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
  <Setter Property="p:Chrome.Hover" Value="{DynamicResource SurfaceHover}"/><Setter Property="p:Chrome.HoverEdge" Value="{DynamicResource ControlHoverBorder}"/>
  <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="40"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="Root">
    <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"/>
    <Border x:Name="HoverLayer" Opacity="0" p:Motion.FadeTo="0" IsHitTestVisible="False" Background="{Binding Path=(p:Chrome.Hover), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{Binding Path=(p:Chrome.HoverEdge), RelativeSource={RelativeSource TemplatedParent}}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"/>
    <ContentPresenter x:Name="ButtonContent" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLayer" Property="p:Motion.FadeTo" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLayer" Property="p:Motion.FadeTo" Value="0.72"/><Setter TargetName="ButtonContent" Property="p:Motion.ShiftY" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource PrimaryKeyboardFocus}"/><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="p:Chrome.Hover" Value="{DynamicResource AccentHover}"/><Setter Property="p:Chrome.HoverEdge" Value="{DynamicResource AccentHover}"/></Style>
 <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,9"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="p:Chrome.Hover" Value="{DynamicResource SurfaceHover}"/></Style>
 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="{DynamicResource Danger}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource DangerLine}"/><Setter Property="p:Chrome.Hover" Value="{DynamicResource DangerWash}"/><Setter Property="p:Chrome.HoverEdge" Value="{DynamicResource Danger}"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource ControlInset}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="44"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="FieldBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlRadius}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource ControlHoverBorder}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Switch (site .switch-track): square thumb slides 18px and crossfades to the accent; the checked state itself is immediate. -->
 <Style TargetType="CheckBox"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid x:Name="Root" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="Track" Width="42" Height="24" BorderThickness="1" BorderBrush="{DynamicResource ControlBorder}" Background="{DynamicResource SurfaceInset}" CornerRadius="{DynamicResource ControlRadius}" HorizontalAlignment="Left" VerticalAlignment="Center">
     <Grid x:Name="Thumb" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" VerticalAlignment="Center"><Border Background="{DynamicResource Muted}" CornerRadius="{DynamicResource ThumbRadius}"/><Border x:Name="ThumbOn" Background="{DynamicResource Accent}" CornerRadius="{DynamicResource ThumbRadius}" Opacity="0" p:Motion.FadeTo="0"/></Grid></Border>
    <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ControlHoverBorder}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter TargetName="Thumb" Property="p:Motion.ShiftX" Value="18"/><Setter TargetName="ThumbOn" Property="p:Motion.FadeTo" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SurfaceHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="MinHeight" Value="44"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}"><Grid Margin="12,8"><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{DynamicResource Text}" Margin="0,0,24,0" VerticalAlignment="Center"/><Path x:Name="Chevron" Data="M0,0 L5,5 L10,0" Width="10" Height="6" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource ControlHoverBorder}"/><Setter TargetName="Chevron" Property="p:Motion.ShiftY" Value="1"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
   <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Grid Margin="0,4,0,14" p:Motion.Reveal="True" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ControlRadius}"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.36"/></Border.Effect></Border><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="4"><ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Grid></Popup></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Surfaces: Card (site glass panel), Lit (accent-line panel), Inset, Notice, Segmented, Dialog. -->
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GlassSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/><Setter Property="Padding" Value="22"/></Style>
 <Style x:Key="InsetPanel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceInset}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/></Style>
 <Style x:Key="Segmented" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceInset}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/><Setter Property="Padding" Value="4"/></Style>
 <Style x:Key="Notice" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/><Setter Property="BorderThickness" Value="2,0,0,0"/><Setter Property="Padding" Value="14,11"/><Setter Property="p:Motion.Reveal" Value="True"/></Style>
 <Style x:Key="Dialog" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Background}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource PanelRadius}"/><Setter Property="Padding" Value="30"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="Separator" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{DynamicResource Border}"/><Setter Property="Margin" Value="0,24"/></Style>
 <!-- Segmented option (site .segmented-options): the choice switches immediately; fills fade in 220ms. -->
 <Style TargetType="RadioButton"><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,11"/><Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Grid x:Name="Root" Background="Transparent">
    <Border x:Name="ModeHover" Opacity="0" p:Motion.FadeTo="0" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ControlRadius}"/>
    <Border x:Name="ModeBorder" Opacity="0" p:Motion.FadeTo="0" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Background="{DynamicResource SurfaceHover}" CornerRadius="{DynamicResource ControlRadius}"/>
    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeHover" Property="p:Motion.FadeTo" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeBorder" Property="p:Motion.FadeTo" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollThumb" Background="{DynamicResource ScrollThumb}" CornerRadius="{DynamicResource SmallRadius}" Margin="4,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ScrollThumbHover}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="TrayMenu" TargetType="ContextMenu"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="5"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="TrayMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Padding" Value="13,9"/><Setter Property="MinWidth" Value="220"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuRow" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="{DynamicResource SmallRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource SurfaceHover}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MenuRow" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="TrayMenuSeparator" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Border}" Margin="7,5"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
