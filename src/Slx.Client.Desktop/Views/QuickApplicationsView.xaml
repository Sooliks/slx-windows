<UserControl x:Class="Slx.Client.Desktop.Views.QuickApplicationsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization">
 <Border Style="{StaticResource Card}" Padding="20"><StackPanel>
  <DockPanel><Button DockPanel.Dock="Right" Content="{l:Tr RefreshApps}" Command="{Binding DiscoverCommand}" Margin="12,0,0,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{l:Tr QuickApps}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{l:Tr QuickAppsHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Label Content="{l:Tr FindRunningApp}" Target="{Binding ElementName=QuickSearch}" Padding="0,15,0,7" Foreground="{DynamicResource Muted}"/>
  <TextBox x:Name="QuickSearch" Text="{Binding DiscoverySearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr FindRunningApp}"/>
  <TextBlock x:Name="LibraryStatus" Text="{Binding LibraryStatusText}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>
  <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding HasLibraryObservation, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{l:Tr LibraryObservation}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{Binding LibraryObservationText}" Foreground="{DynamicResource Muted}" FontSize="13"/></StackPanel>
  <StackPanel x:Name="LibraryLoading" Margin="0,9,0,0" Visibility="{Binding Discovering, Converter={StaticResource VisibleWhen}}"><ProgressBar IsIndeterminate="True" Height="3" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" AutomationProperties.Name="{l:Tr FindingApps}"/></StackPanel>
  <ItemsControl ItemsSource="{Binding FilteredLibrary}" Margin="0,16,0,0">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button Width="220" Height="92" Padding="14" Margin="0,0,10,10" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.AddLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{l:Tr Add}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image Source="{Binding Icon}" Width="44" Height="44" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Action}" Foreground="{DynamicResource Accent}" FontSize="13" Margin="0,5,0,0"/>
      </StackPanel>
     </Grid>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button Content="{l:Tr LibraryMore}" Command="{Binding ShowMoreApplicationsCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding HasMoreLibraryResults, Converter={StaticResource VisibleWhen}}"/>
  <TextBlock x:Name="LibraryEmpty" Text="{l:Tr QuickAppsEmpty}" FontSize="13" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDiscoveryResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Discovering}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel></Border>
</UserControl>
