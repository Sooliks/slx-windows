<UserControl x:Class="Slx.Client.Desktop.Views.DiscoveryOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" KeyboardNavigation.TabNavigation="Cycle">
 <Grid Background="{DynamicResource Backdrop}"><Border Style="{StaticResource Dialog}" Width="620" p:Motion.Reveal="True"><StackPanel>
  <TextBlock Text="{l:Tr DiscoveryTitle}" FontFamily="{DynamicResource FontDisplay}" FontWeight="{DynamicResource DisplayWeight}" FontSize="25" Margin="0,0,0,15"/><TextBlock Text="{l:Tr DiscoveryDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
  <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Discovered}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,11"><DockPanel><Button DockPanel.Dock="Right" Content="{l:Tr Add}" Command="{Binding DataContext.AddDiscoveredCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="15,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutablePath}" FontSize="13" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="405" ToolTip="{Binding ExecutablePath}" Margin="0,6,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  <TextBlock Text="{l:Tr NothingRunning}" Foreground="{DynamicResource Muted}" Margin="0,5,0,15"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDiscovered}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Button Content="{l:Tr Close}" Command="{Binding CancelOverlayCommand}" HorizontalAlignment="Right" Margin="0,22,0,0"/>
 </StackPanel></Border></Grid>
</UserControl>
