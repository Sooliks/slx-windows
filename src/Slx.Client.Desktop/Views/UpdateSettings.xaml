<UserControl x:Class="Slx.Client.Desktop.Views.UpdateSettings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization">
 <StackPanel>
  <TextBlock Text="{l:Tr UpdatesTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
  <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18"><StackPanel>
   <TextBlock Text="{Binding CurrentVersionCaption}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding BannerDescription}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Visibility="{Binding HasOffer, Converter={StaticResource VisibleWhen}}">
    <TextBlock Text="{Binding OfferTitle}" FontWeight="Bold" Margin="0,0,0,4"/>
    <TextBlock Text="{l:Tr UpdateSavedOffer}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,10" Visibility="{Binding IsOfferDeferred, Converter={StaticResource VisibleWhen}}"/>
    <Button x:Name="UpdateSettingsApply" Content="{Binding ActionText}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="{Binding ActionName}" AutomationProperties.HelpText="{Binding InstallHint}"/>
    <TextBlock Text="{Binding InstallHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,8,0,12" TextWrapping="Wrap" Visibility="{Binding ShowInstallHint, Converter={StaticResource VisibleWhen}}"/>
    <Grid Margin="0,9,0,12" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" AutomationProperties.Name="{l:Tr UpdateDownloading}"/>
     <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource Text}" FontSize="13" Margin="14,0,0,0"/>
    </Grid>
   </StackPanel>
   <Button Content="{l:Tr UpdateCheck}" Command="{Binding CheckCommand}" HorizontalAlignment="Left"/>
  </StackPanel></Border>
  <CheckBox IsChecked="{Binding Automatic}"><TextBlock Text="{l:Tr UpdatesAutomatic}" TextWrapping="Wrap"/></CheckBox>
  <TextBlock Text="{l:Tr UpdatesPrivacy}" Style="{StaticResource MutedText}" FontSize="13" Margin="48,7,0,0"/>
 </StackPanel>
</UserControl>
