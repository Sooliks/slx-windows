<UserControl x:Class="Slx.Client.Desktop.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation">
 <UserControl.Resources>
  <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="0,0,0,8"/></Style>
  <!-- Status tone (site status.css): connected = lit accent panel, attention = danger line, unknown = hollow marker, off = plain. -->
  <Style x:Key="StatusPanel" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="20"/><Style.Triggers>
   <DataTrigger Binding="{Binding StatusTone}" Value="connected"><Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/><Setter Property="Background" Value="{DynamicResource SignalSurface}"/></DataTrigger>
   <DataTrigger Binding="{Binding StatusTone}" Value="attention"><Setter Property="BorderBrush" Value="{DynamicResource DangerLine}"/></DataTrigger>
   <DataTrigger Binding="{Binding StatusTone}" Value="active"><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/></DataTrigger>
  </Style.Triggers></Style>
  <Style x:Key="StatusMarker" TargetType="Rectangle"><Setter Property="Width" Value="8"/><Setter Property="Height" Value="8"/><Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/><Setter Property="StrokeThickness" Value="1.5"/><Setter Property="Fill" Value="{DynamicResource Muted}"/><Setter Property="Stroke" Value="{DynamicResource Muted}"/><Style.Triggers>
   <DataTrigger Binding="{Binding StatusTone}" Value="connected"><Setter Property="Fill" Value="{DynamicResource Accent}"/><Setter Property="Stroke" Value="{DynamicResource Accent}"/></DataTrigger>
   <DataTrigger Binding="{Binding StatusTone}" Value="active"><Setter Property="Fill" Value="Transparent"/><Setter Property="Stroke" Value="{DynamicResource Accent}"/></DataTrigger>
   <DataTrigger Binding="{Binding StatusTone}" Value="attention"><Setter Property="Fill" Value="{DynamicResource Danger}"/><Setter Property="Stroke" Value="{DynamicResource Danger}"/></DataTrigger>
   <DataTrigger Binding="{Binding StatusTone}" Value="unknown"><Setter Property="Fill" Value="Transparent"/></DataTrigger>
  </Style.Triggers></Style>
  <Style x:Key="AppChip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ControlFill}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MaxWidth" Value="340"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <ScrollViewer x:Name="ConnectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" p:ScrollMemory.Key="connection">
  <StackPanel Margin="0,4,26,22">
   <TextBlock Text="{l:Tr Eyebrow}" Style="{StaticResource MonoLabel}"/>
   <TextBlock Text="{l:Tr ConnectionTitle}" Style="{StaticResource PageTitle}" Margin="0,6,0,6"/>
   <TextBlock Text="{l:Tr ConnectionSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
   <Border x:Name="StatusCard" Style="{StaticResource StatusPanel}" Margin="0,0,0,20">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,8,0,0" IsHitTestVisible="False">
        <Rectangle x:Name="StatusConfirmRing" Stroke="{DynamicResource Accent}" StrokeThickness="1" RadiusX="1" RadiusY="1" Opacity="0" p:Motion.ConfirmWhen="{Binding IsConnected}"/>
        <Rectangle x:Name="StatusMarker" Style="{StaticResource StatusMarker}"/>
       </Grid>
       <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontFamily="{DynamicResource FontUi}" FontWeight="Bold" FontSize="17" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="19" Margin="20,7,0,0"/>
      <TextBlock Text="{Binding ServiceCodeLabel}" Style="{StaticResource MonoLabel}" FontSize="13" Margin="20,5,0,0" Visibility="{Binding HasServiceCode, Converter={StaticResource VisibleWhen}}"/>
      <TextBlock Text="{l:Tr Busy}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="20,7,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}">
      <Button x:Name="ConnectAction" Content="{Binding ConnectionAction}" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource PrimaryButton}" MinWidth="154" MinHeight="46" Padding="18,11"/>
      <Button Command="{Binding ReconnectCommand}" AutomationProperties.Name="{l:Tr Reconnect}" ToolTip="{l:Tr Reconnect}" Margin="9,0,0,0" Width="46" MinHeight="46" Padding="0"><Path Style="{StaticResource NavIcon}" Stroke="{DynamicResource Text}" StrokeThickness="1.6" Data="M14,5 A6,6 0 1 0 15,10 M10,5 H15 V0"/></Button>
     </StackPanel>
     <Button Grid.Column="1" Content="{l:Tr ImportButton}" Command="{Binding OpenImportCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Visibility="{Binding NoSubscription, Converter={StaticResource VisibleWhen}}"/>
    </Grid>
   </Border>
   <StackPanel Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><Label Content="{l:Tr Profile}" Target="{Binding ElementName=ConnectionProfile}" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ConnectionProfile" IsEnabled="{Binding CanEditRouting}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileNameTemplate}" AutomationProperties.Name="{l:Tr Profile}"/>
      <TextBlock Text="{Binding SubscriptionRefreshHint}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="18" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr RoutingTitle}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource FontUi}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
      <Border Style="{StaticResource Segmented}" IsEnabled="{Binding CanEditRouting}"><UniformGrid Columns="2"><RadioButton IsChecked="{Binding IsSelectedMode}" GroupName="ConnectionMode" AutomationProperties.Name="{l:Tr ModeSelected}" Margin="0,0,4,0" Padding="9,9" MinHeight="40" FontSize="14"><TextBlock Text="{l:Tr ModeSelected}"/></RadioButton><RadioButton IsChecked="{Binding IsWholeMode}" GroupName="ConnectionMode" AutomationProperties.Name="{l:Tr ModeWhole}" Padding="9,9" MinHeight="40" FontSize="14"><TextBlock Text="{l:Tr ModeWhole}"/></RadioButton></UniformGrid></Border>
      <TextBlock x:Name="ModeSummary" Text="{Binding ModeDescription}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="18" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="SelectedAppsSection" Visibility="{Binding IsSelectedMode, Converter={StaticResource VisibleWhen}}" Margin="0,17,0,0">
     <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12"/>
     <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="{l:Tr ManageApps}" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="applications" MinHeight="28" Padding="8,4" Margin="0,0,-8,0" FontSize="13"/><TextBlock Text="{l:Tr SelectedApps}" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center"/></DockPanel>
     <ItemsControl IsEnabled="{Binding CanEditRouting}" ItemsSource="{Binding SelectedApplications}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Style="{StaticResource AppChip}">
       <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{l:Tr RouteChoiceHint}" ToolTip="{Binding Name}"><DockPanel><Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" MaxWidth="240" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13"/></DockPanel></CheckBox>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock x:Name="RulesLiveHint" Text="{l:Tr RulesNotice}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="18" Margin="0,4,0,0" Visibility="{Binding IsConnected, Converter={StaticResource VisibleWhen}}"/>
    </StackPanel>
    <TextBlock Text="{Binding RoutingUpdateText}" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource FontUi}" FontSize="13" Margin="0,10,0,0" Visibility="{Binding RulesPending, Converter={StaticResource VisibleWhen}}" p:Motion.Reveal="True"/>
    <Border x:Name="SubscriptionSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
     <DockPanel><Button Content="{l:Tr UpdateSubscription}" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" FontSize="13" Padding="13,8" MinHeight="36" Margin="16,0,0,0"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SubscriptionTitle}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubscriptionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{l:Tr Expires}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{Binding SubscriptionExpiry}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource FontUi}" FontSize="13"/></StackPanel></StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
   <StackPanel x:Name="ConnectionFacts" Margin="0,22,0,0" Visibility="{Binding HasConnectionFacts, Converter={StaticResource VisibleWhen}}" p:Motion.Reveal="True">
    <TextBlock Text="{l:Tr StatsTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
    <Border Style="{StaticResource Card}" Padding="0"><UniformGrid Rows="1">
     <Border Padding="16" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><StackPanel><TextBlock Text="{l:Tr StatsDuration}" Style="{StaticResource MutedText}" FontSize="13"/><TextBlock Text="{Binding ConnectionDuration}" Style="{StaticResource DataValue}" Margin="0,9,0,0"/></StackPanel></Border>
     <Border x:Name="ActiveProtocolFact" Padding="16" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Visibility="{Binding HasActiveProtocol, Converter={StaticResource VisibleWhen}}"><StackPanel><TextBlock Text="{l:Tr StatsProtocol}" Style="{StaticResource MutedText}" FontSize="13"/><TextBlock Text="{Binding ActiveProtocol}" Style="{StaticResource DataValue}" Margin="0,9,0,0"/></StackPanel></Border>
     <Border Padding="16"><StackPanel><TextBlock Text="{l:Tr StatsApps}" Style="{StaticResource MutedText}" FontSize="13"/><TextBlock Text="{Binding SelectedAppCount}" Style="{StaticResource DataValue}" Margin="0,9,0,0"/></StackPanel></Border>
    </UniformGrid></Border>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{l:Tr StatsChecked}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{Binding LastConnectionCheck}" Style="{StaticResource MutedText}" FontFamily="{DynamicResource FontUi}" FontSize="13"/></StackPanel>
   </StackPanel>
   <TextBlock Text="{l:Tr AlphaNotice}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="19" Margin="0,16,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
