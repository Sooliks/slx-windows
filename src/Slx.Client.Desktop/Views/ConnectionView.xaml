<UserControl x:Class="Slx.Client.Desktop.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,12,0">
  <TextBlock Text="{l:Tr Eyebrow}" Style="{StaticResource MonoLabel}"/><TextBlock Text="{l:Tr ConnectionTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Tr ConnectionSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,28"/>
  <Border Style="{StaticResource Card}" Padding="25" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Ellipse Width="7" Height="7" Margin="0,0,9,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" MaxWidth="410" HorizontalAlignment="Left"/>
   <StackPanel Orientation="Horizontal" Margin="0,22,0,0" Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}"><Button Content="{Binding ConnectionAction}" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource PrimaryButton}" MinWidth="178" MinHeight="48"/><Button Content="↻" Command="{Binding ReconnectCommand}" AutomationProperties.Name="{l:Tr Reconnect}" ToolTip="{l:Tr Reconnect}" Margin="10,0,0,0" Width="48" FontSize="23"/></StackPanel>
   <Button Content="{l:Tr ImportButton}" Command="{Binding OpenImportCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Visibility="{Binding NoSubscription, Converter={StaticResource VisibleWhen}}"/>
   <TextBlock Text="{l:Tr Busy}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
  </StackPanel><Viewbox Grid.Column="1" MaxWidth="116" MaxHeight="130" Opacity="0.34" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False"><Canvas Width="100" Height="110"><Path Fill="{DynamicResource Accent}" Data="M 3,1 L 24,1 60,57 48,77 Z M 72,1 L 98,1 65,49 52,28 Z M 57,75 L 69,57 98,107 73,107 Z M 31,64 L 45,87 30,107 3,107 Z"/></Canvas></Viewbox></Grid></Border>
  <StackPanel Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}">
   <Label Content="{l:Tr Profile}" Target="{Binding ElementName=ConnectionProfile}" Foreground="{DynamicResource Muted}" Padding="0,0,0,8"/>
   <ComboBox IsEnabled="{Binding CanEditRouting}" x:Name="ConnectionProfile" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" AutomationProperties.Name="{l:Tr Profile}" Margin="0,0,0,9"/>
   <TextBlock Text="{l:Tr AutoProfile}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,25"/>
   <TextBlock Text="{l:Tr RoutingTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,13"/>
   <UniformGrid IsEnabled="{Binding CanEditRouting}" Columns="2"><RadioButton IsChecked="{Binding IsSelectedMode}" GroupName="ConnectionMode" Content="{l:Tr ModeSelected}" Margin="0,0,10,0"/><RadioButton IsChecked="{Binding IsWholeMode}" GroupName="ConnectionMode" Content="{l:Tr ModeWhole}"/></UniformGrid>
   <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
   <Border Style="{StaticResource Separator}"/>
   <StackPanel Visibility="{Binding IsSelectedMode, Converter={StaticResource VisibleWhen}}">
   <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{l:Tr ManageApps}" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="applications"/><TextBlock Text="{l:Tr SelectedApps}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <ItemsControl ItemsSource="{Binding SelectedApplications}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="11,9" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <TextBlock Text="{l:Tr RulesPending}" Foreground="{DynamicResource Accent}" Margin="0,10,0,0" Visibility="{Binding RulesPending, Converter={StaticResource VisibleWhen}}"/>
   <Border Style="{StaticResource Separator}"/>
   <DockPanel><Button Content="{l:Tr UpdateSubscription}" DockPanel.Dock="Right" Command="{Binding RefreshCommand}"/><StackPanel><TextBlock Text="{Binding SubscriptionTitle}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{l:Tr Expires}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{Binding SubscriptionExpiry}" Style="{StaticResource MutedText}" FontSize="12"/></StackPanel></StackPanel></DockPanel>
  </StackPanel>
  <TextBlock Text="{l:Tr AlphaNotice}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,26,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
