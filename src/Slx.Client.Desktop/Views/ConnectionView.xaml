<UserControl x:Class="Slx.Client.Desktop.Views.ConnectionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization">
 <ScrollViewer x:Name="ConnectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="0,4,26,22">
   <TextBlock Text="{l:Tr Eyebrow}" Style="{StaticResource MonoLabel}"/>
   <TextBlock Text="{l:Tr ConnectionTitle}" Style="{StaticResource PageTitle}" FontSize="29" Margin="0,6,0,6"/>
   <TextBlock Text="{l:Tr ConnectionSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
   <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,9,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="16" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource MutedText}" FontSize="12" LineHeight="19" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ServiceCodeLabel}" Style="{StaticResource MonoLabel}" FontSize="10" Margin="0,5,0,0" Visibility="{Binding HasServiceCode, Converter={StaticResource VisibleWhen}}"/>
      <TextBlock Text="{l:Tr Busy}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,7,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}">
      <Button x:Name="ConnectAction" Content="{Binding ConnectionAction}" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanConnect}" Style="{StaticResource PrimaryButton}" MinWidth="154" MinHeight="44" Padding="16,10"/>
      <Button Content="↻" Command="{Binding ReconnectCommand}" AutomationProperties.Name="{l:Tr Reconnect}" ToolTip="{l:Tr Reconnect}" Margin="9,0,0,0" Width="44" MinHeight="44" Padding="0" FontSize="23"/>
     </StackPanel>
     <Button Grid.Column="1" Content="{l:Tr ImportButton}" Command="{Binding OpenImportCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Visibility="{Binding NoSubscription, Converter={StaticResource VisibleWhen}}"/>
    </Grid>
   </Border>
   <StackPanel Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel><Label Content="{l:Tr Profile}" Target="{Binding ElementName=ConnectionProfile}" Foreground="{DynamicResource Muted}" Padding="0,0,0,8"/>
      <ComboBox x:Name="ConnectionProfile" IsEnabled="{Binding CanEditRouting}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileNameTemplate}" AutomationProperties.Name="{l:Tr Profile}"/>
      <TextBlock Text="{Binding SubscriptionRefreshHint}" Style="{StaticResource MutedText}" FontSize="11" LineHeight="18" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="{l:Tr RoutingTitle}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
      <UniformGrid IsEnabled="{Binding CanEditRouting}" Columns="2"><RadioButton IsChecked="{Binding IsSelectedMode}" GroupName="ConnectionMode" Content="{l:Tr ModeSelected}" Margin="0,0,7,0" Padding="10,12" FontSize="12"/><RadioButton IsChecked="{Binding IsWholeMode}" GroupName="ConnectionMode" Content="{l:Tr ModeWhole}" Padding="10,12" FontSize="12"/></UniformGrid>
      <TextBlock x:Name="ModeSummary" Text="{Binding ModeDescription}" Style="{StaticResource MutedText}" FontSize="11" LineHeight="18" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel x:Name="SelectedAppsSection" Visibility="{Binding IsSelectedMode, Converter={StaticResource VisibleWhen}}" Margin="0,17,0,0">
     <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
     <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:Tr ManageApps}" Style="{StaticResource LinkButton}" Command="{Binding NavigateCommand}" CommandParameter="applications" MinHeight="28" Padding="0" FontSize="12"/><TextBlock Text="{l:Tr SelectedApps}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <ItemsControl IsEnabled="{Binding CanEditRouting}" ItemsSource="{Binding SelectedApplications}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="10,10" Margin="0,0,8,6" MaxWidth="300">
       <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}">
        <DockPanel><Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" MaxWidth="190" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12"/></DockPanel>
       </CheckBox>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

    </StackPanel>
    <TextBlock Text="{Binding RoutingUpdateText}" Foreground="{DynamicResource Accent}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding RulesPending, Converter={StaticResource VisibleWhen}}"/>
    <Border x:Name="SubscriptionSection" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
     <DockPanel><Button Content="{l:Tr UpdateSubscription}" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" FontSize="12" Padding="13,8" MinHeight="34" Margin="16,0,0,0"/>
      <StackPanel><TextBlock Text="{Binding SubscriptionTitle}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SubscriptionTitle}"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{l:Tr Expires}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,8,0"/><TextBlock Text="{Binding SubscriptionExpiry}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></StackPanel>
     </DockPanel>
    </Border>
   </StackPanel>
    <StackPanel Margin="0,22,0,0">
     <TextBlock Text="{l:Tr StatsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <UniformGrid Columns="3">
      <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="{l:Tr StatsDuration}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding ConnectionDuration}" FontFamily="Consolas" FontSize="23" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="{l:Tr StatsProtocol}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding ActiveProtocol}" FontSize="22" Margin="0,9,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="15"><StackPanel><TextBlock Text="{l:Tr StatsApps}" Style="{StaticResource MutedText}" FontSize="11"/><TextBlock Text="{Binding SelectedAppCount}" FontSize="23" Margin="0,9,0,0"/></StackPanel></Border>
     </UniformGrid>
     <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{l:Tr StatsChecked}" Style="{StaticResource MutedText}" FontSize="10" Margin="0,0,8,0"/><TextBlock Text="{Binding LastConnectionCheck}" Style="{StaticResource MutedText}" FontSize="10"/></StackPanel>
    </StackPanel>

   <TextBlock Text="{l:Tr AlphaNotice}" Style="{StaticResource MutedText}" FontSize="10" LineHeight="16" Margin="0,16,0,0"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
