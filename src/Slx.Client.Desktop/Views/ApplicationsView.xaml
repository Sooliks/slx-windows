<UserControl x:Class="Slx.Client.Desktop.Views.ApplicationsView" IsEnabled="{Binding CanEditRouting}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,8,26,22">
  <TextBlock Text="{l:Tr NavApplications}" Style="{StaticResource MonoLabel}"/><TextBlock Text="{l:Tr AppsTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Tr AppsSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
  <v:QuickApplicationsView Margin="0,0,0,22"/>
  <Button Content="{l:Tr AddExecutable}" Command="{Binding AddExecutableCommand}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
  <TextBlock Text="{l:Tr AddedApps}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
  <Label Content="{l:Tr SearchApps}" Foreground="{DynamicResource Muted}" Target="{Binding ElementName=SearchField}" Padding="0,0,0,8"/><TextBox x:Name="SearchField" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr SearchApps}" ToolTip="{l:Tr SearchApps}" Margin="0,0,0,18"/>
  <ItemsControl ItemsSource="{Binding FilteredApplications}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePaths}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel>
   <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" AutomationProperties.Name="{l:Tr RouteApp}" AutomationProperties.HelpText="{Binding Name}" ToolTip="{l:Tr RouteApp}" VerticalAlignment="Center"/>
   <Button Grid.Column="3" Content="×" Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" MinHeight="32" Width="32" Style="{StaticResource LinkButton}" AutomationProperties.Name="{l:Tr RemoveApp}" AutomationProperties.HelpText="{Binding Name}" ToolTip="{l:Tr RemoveApp}"/>
  </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Foreground="{DynamicResource Muted}" Margin="0,16,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="{l:Tr NoSearchResults}"/><Style.Triggers><DataTrigger Binding="{Binding HasApplications}" Value="False"><Setter Property="Text" Value="{l:Tr NoAppsDescription}"/></DataTrigger><DataTrigger Binding="{Binding HasSearchResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border Margin="0,20,0,0" Padding="15" Background="{DynamicResource SurfaceRaised}" Visibility="{Binding RulesPending, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding RoutingUpdateText}" TextWrapping="Wrap"/></Border>
  <TextBlock Text="{l:Tr RulesNotice}" Style="{StaticResource MutedText}" Margin="0,25,0,10"/><TextBlock Text="{l:Tr AppLimitations}" Style="{StaticResource MutedText}" FontSize="12"/>
 </StackPanel></ScrollViewer>
</UserControl>
