<UserControl x:Class="Slx.Client.Desktop.Views.ApplicationsView" IsEnabled="{Binding CanEditRouting}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation">
 <UserControl.Resources>
  <!-- Site route-console rows: inset row, accent line while the app is chosen for VPN. -->
  <Style x:Key="AppRow" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ControlInset}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,8"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" p:ScrollMemory.Key="applications"><StackPanel Margin="0,8,26,22">
  <TextBlock Text="{l:Tr NavApplications}" Style="{StaticResource MonoLabel}"/><TextBlock Text="{l:Tr AppsTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Tr AppsSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
  <v:QuickApplicationsView Margin="0,0,0,22"/>
  <Button Content="{l:Tr AddExecutable}" Command="{Binding AddExecutableCommand}" HorizontalAlignment="Left" Margin="0,0,0,24"/>
  <DockPanel Margin="0,0,0,16"><TextBlock x:Name="AppsActivity" DockPanel.Dock="Right" Text="{Binding RoutingUpdateText}" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource FontUi}" FontSize="13" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="16,0,0,0" Visibility="Hidden" p:Presence.Show="{Binding RulesPending}" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{l:Tr AddedApps}" Style="{StaticResource PanelTitle}"/></DockPanel>
  <Label Content="{l:Tr SearchApps}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource FontUi}" FontSize="13" FontWeight="Bold" Target="{Binding ElementName=SearchField}" Padding="0,0,0,8"/><TextBox x:Name="SearchField" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:Tr SearchApps}" ToolTip="{l:Tr SearchApps}" Margin="0,0,0,18"/>
  <ItemsControl ItemsSource="{Binding FilteredApplications}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource AppRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="56"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
   <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="{Binding ExecutablePath}" ToolTip="{Binding ExecutablePaths}" Foreground="{DynamicResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,5,0,0"/></StackPanel>
   <CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" AutomationProperties.Name="{l:Tr RouteApp}" AutomationProperties.HelpText="{Binding Name}" ToolTip="{l:Tr RouteChoiceHint}" VerticalAlignment="Center"/>
   <Button Grid.Column="4" Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="0" MinHeight="32" Width="32" HorizontalContentAlignment="Center" Style="{StaticResource LinkButton}" p:Chrome.Hover="{DynamicResource DangerWash}" AutomationProperties.Name="{l:Tr RemoveApp}" AutomationProperties.HelpText="{Binding Name}" ToolTip="{l:Tr RemoveApp}"><Path Data="M0,0 L8,8 M8,0 L0,8" Width="9" Height="9" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
  </Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Foreground="{DynamicResource Muted}" Margin="0,16,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Text" Value="{l:Tr NoSearchResults}"/><Style.Triggers><DataTrigger Binding="{Binding HasApplications}" Value="False"><Setter Property="Text" Value="{l:Tr NoAppsDescription}"/></DataTrigger><DataTrigger Binding="{Binding HasSearchResults}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <TextBlock Text="{l:Tr RulesNotice}" Style="{StaticResource MutedText}" Margin="0,25,0,10"/><TextBlock Text="{l:Tr AppLimitations}" Style="{StaticResource MutedText}" FontSize="13"/>
 </StackPanel></ScrollViewer>
</UserControl>
