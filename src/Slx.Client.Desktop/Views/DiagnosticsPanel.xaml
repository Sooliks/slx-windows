<UserControl x:Class="Slx.Client.Desktop.Views.DiagnosticsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization">
 <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
  <TextBlock Text="{l:Tr DiagnosticsTitle}" Style="{StaticResource SectionTitle}"/>
  <TextBlock Text="{l:Tr DiagnosticsPrivacy}" Style="{StaticResource MutedText}" Margin="0,10,0,14"/>
  <Button Content="{l:Tr DiagnosticsCopy}" Command="{Binding CopyDiagnosticsCommand}" HorizontalAlignment="Left"/>
 </StackPanel></Border>
</UserControl>
