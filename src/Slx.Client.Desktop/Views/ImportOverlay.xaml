<UserControl x:Class="Slx.Client.Desktop.Views.ImportOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" KeyboardNavigation.TabNavigation="Cycle">
 <Grid Background="{DynamicResource Backdrop}"><Border Style="{StaticResource Dialog}" Width="590" p:Motion.Reveal="True"><StackPanel>
  <TextBlock Text="{l:Tr ImportTitle}" FontFamily="{DynamicResource FontDisplay}" FontWeight="{DynamicResource DisplayWeight}" FontSize="25" Margin="0,0,0,15"/><TextBlock Text="{l:Tr ImportDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,24"/>
  <DockPanel Margin="0,0,0,8"><Button x:Name="PasteLink" DockPanel.Dock="Right" Content="{l:Tr PasteLink}" Command="{Binding PasteLinkCommand}" Style="{StaticResource LinkButton}" MinHeight="28" Padding="8,4" Margin="0,-4,-8,-4" FontSize="13"/><Label Content="{l:Tr LinkLabel}" Target="{Binding ElementName=LinkInput}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource FontUi}" FontSize="13" FontWeight="Bold" Padding="0" VerticalAlignment="Center"/></DockPanel>
  <TextBox x:Name="LinkInput" Text="{Binding ImportLink, UpdateSourceTrigger=PropertyChanged}" SpellCheck.IsEnabled="False" AutomationProperties.Name="{l:Tr LinkLabel}" ToolTip="{l:Tr LinkPlaceholder}" MaxLength="2048" Margin="0,0,0,15" FontFamily="{DynamicResource FontUi}" FontSize="13"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsReadOnly" Value="True"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
  <TextBlock Text="{Binding Message}" Visibility="{Binding ShowMessage, Converter={StaticResource VisibleOrHidden}}" MinHeight="19" Foreground="{DynamicResource Danger}" Margin="0,0,0,14" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="ImportFootnote" Text="{Binding ImportFootnoteText}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="19" MinHeight="38" Margin="0,0,0,24" AutomationProperties.LiveSetting="Polite"/>
  <WrapPanel HorizontalAlignment="Right"><Button Content="{l:Tr Cancel}" Command="{Binding CancelOverlayCommand}" Margin="0,0,10,0"/><Button Content="{l:Tr ImportAction}" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" MinWidth="130" IsDefault="True"/></WrapPanel>
  <TextBlock Text="{l:Tr Busy}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,15,0,0" Visibility="Hidden" p:Presence.Show="{Binding IsBusy}"/>
 </StackPanel></Border></Grid>
</UserControl>
