<UserControl x:Class="Slx.Client.Desktop.Views.UpdateBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" Visibility="{Binding ShowBanner, Converter={StaticResource VisibleWhen}}">
 <Border Style="{StaticResource Card}" Background="{DynamicResource AccentWash}" Padding="18,14" Margin="0,0,0,14" BorderBrush="{DynamicResource Accent}">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="{Binding OfferTitle}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ActionText}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="{l:Tr UpdateLater}" Command="{Binding LaterCommand}"/></StackPanel>
   </Grid>
   <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" BorderThickness="0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}" AutomationProperties.Name="{l:Tr UpdateDownloading}"/>
   <TextBlock Text="{Binding InstallHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
</UserControl>