<UserControl x:Class="Slx.Client.Desktop.Views.UpdateBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" Visibility="{Binding ShowBanner, Converter={StaticResource VisibleWhen}}">
 <!-- Floating card (site popup shadow): the shadow is a sibling so text never renders through an effect. -->
 <Grid p:Motion.Reveal="True">
 <Border Background="{DynamicResource Background}" CornerRadius="{DynamicResource PanelRadius}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect Color="Black" BlurRadius="32" ShadowDepth="12" Direction="270" Opacity="0.34"/></Border.Effect></Border>
 <Border x:Name="UpdateCard" Style="{StaticResource Card}" Background="{DynamicResource Surface}" Padding="18,16" BorderBrush="{DynamicResource ControlBorder}">
  <StackPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="32" Height="32" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource AccentWash}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1" VerticalAlignment="Top" Margin="0,4,0,0" HorizontalAlignment="Left" IsHitTestVisible="False">
     <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="17" Height="19" Stretch="Uniform" Data="M8,1 V12 M3,7 L8,12 13,7 M1,14 V18 H15 V14"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock x:Name="UpdateOfferTitle" Text="{Binding OfferTitle}" FontFamily="{DynamicResource FontUi}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
     <TextBlock Text="{Binding CurrentVersionCaption}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0"/>
    </StackPanel>
   </Grid>
   <TextBlock x:Name="UpdateBannerStatus" Text="{Binding BannerDescription}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <Grid Margin="0,9,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="5" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceInset}" BorderThickness="0" AutomationProperties.Name="{l:Tr UpdateDownloading}"/>
    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource FontUi}" FontSize="13" Margin="14,0,0,0"/>
   </Grid>
   <TextBlock Text="{Binding InstallHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="{Binding ShowInstallHint, Converter={StaticResource VisibleWhen}}"/>
   <WrapPanel Margin="0,14,0,0" KeyboardNavigation.TabNavigation="Continue">
    <Button x:Name="UpdateApply" Content="{Binding ActionText}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="116" Margin="0,0,8,0" AutomationProperties.Name="{Binding ActionName}" AutomationProperties.HelpText="{Binding InstallHint}"/>
    <Button x:Name="UpdateLater" Content="{Binding LaterText}" Command="{Binding LaterCommand}" MinWidth="76" ToolTip="{Binding LaterHint}" AutomationProperties.Name="{Binding LaterName}" AutomationProperties.HelpText="{Binding LaterHint}"/>
   </WrapPanel>
  </StackPanel>
 </Border>
 </Grid>
</UserControl>
