<UserControl x:Class="Slx.Client.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation">
 <UserControl.Resources><Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontFamily" Value="{DynamicResource FontUi}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="0,0,0,8"/></Style></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" p:ScrollMemory.Key="settings"><StackPanel Margin="0,8,26,22">
  <TextBlock Text="{l:Tr NavSettings}" Style="{StaticResource MonoLabel}"/><TextBlock Text="{l:Tr SettingsTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Tr SettingsSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,25"/>
  <Border Visibility="{Binding HasPreferencesFault, Converter={StaticResource VisibleWhen}}" BorderBrush="{DynamicResource DangerLine}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="14" Margin="0,0,0,20"><TextBlock Text="{l:Tr PreferencesSessionOnly}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite"/></Border>
  <TextBlock Text="{l:Tr Appearance}" Style="{StaticResource PanelTitle}" Margin="0,0,0,16"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><Label Content="{l:Tr Language}" Target="{Binding ElementName=LanguageSelect}"/><ComboBox x:Name="LanguageSelect" SelectedValue="{Binding Language}" SelectedValuePath="Tag" AutomationProperties.Name="{l:Tr Language}"><ComboBoxItem Content="{l:Tr LanguageRu}" Tag="ru"/><ComboBoxItem Content="{l:Tr LanguageEn}" Tag="en"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><Label Content="{l:Tr Theme}" Target="{Binding ElementName=ThemeSelect}"/><ComboBox x:Name="ThemeSelect" SelectedValue="{Binding Theme}" SelectedValuePath="Tag" AutomationProperties.Name="{l:Tr Theme}"><ComboBoxItem Content="{l:Tr ThemeOlive}" Tag="olive"/><ComboBoxItem Content="{l:Tr ThemeTerminal}" Tag="terminal"/></ComboBox></StackPanel></Grid>
  <Border Style="{StaticResource Separator}"/>
  <TextBlock Text="{l:Tr Behavior}" Style="{StaticResource PanelTitle}" Margin="0,0,0,20"/>
  <CheckBox IsChecked="{Binding AutoStart}"><TextBlock Text="{l:Tr AutoStart}"/></CheckBox><TextBlock Text="{l:Tr AutoStartHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="48,7,0,24"/>
  <CheckBox x:Name="AutoConnectStartupOption" IsChecked="{Binding AutoConnectOnStartup}" IsEnabled="{Binding AutoStart}" AutomationProperties.Name="{l:Tr AutoConnectStartup}" AutomationProperties.HelpText="{l:Tr AutoConnectStartupHint}"><TextBlock Text="{l:Tr AutoConnectStartup}"/></CheckBox><TextBlock Text="{l:Tr AutoConnectStartupHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="48,7,0,24"/>
  <CheckBox IsChecked="{Binding MinimizeToTray}"><TextBlock Text="{l:Tr MinimizeTray}"/></CheckBox><TextBlock Text="{l:Tr MinimizeTrayHint}" Style="{StaticResource MutedText}" FontSize="13" Margin="48,7,0,0"/>
  <Border Style="{StaticResource Separator}"/>
  <v:UpdateSettings DataContext="{Binding Updates}"/>
  <Border Style="{StaticResource Separator}"/>
  <TextBlock Text="{l:Tr SubscriptionSettings}" Style="{StaticResource PanelTitle}" Margin="0,0,0,16"/>
  <TextBlock Text="{l:Tr AutoProfile}" Style="{StaticResource MutedText}" Margin="0,0,0,15"/>
  <Label Content="{l:Tr Profile}" Target="{Binding ElementName=ProfileSelect}"/>
  <ComboBox IsEnabled="{Binding CanEditRouting}" x:Name="ProfileSelect" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource ProfileNameTemplate}" AutomationProperties.Name="{l:Tr Profile}" Margin="0,0,0,8"/>
  <TextBlock Text="{l:Tr ProfileAdvanced}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,0,0,18"/>
  <WrapPanel><Button Content="{l:Tr UpdateSubscription}" Command="{Binding RefreshCommand}" Margin="0,0,9,8"/><Button Content="{l:Tr ReplaceSubscription}" Command="{Binding OpenImportCommand}" Margin="0,0,9,8"/><Button Content="{l:Tr RemoveSubscription}" Command="{Binding AskRemoveCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8"/></WrapPanel>
  <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding HasSubscription, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{l:Tr Freshness}" Style="{StaticResource MonoLabel}" Margin="0,0,8,0"/><TextBlock Text="{Binding SubscriptionUpdated}" Style="{StaticResource MonoLabel}"/></StackPanel>
 </StackPanel></ScrollViewer>
</UserControl>
