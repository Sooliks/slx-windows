<UserControl x:Class="Slx.Client.Desktop.Views.QuickStartView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation">
 <!-- First-run choice. Suggestions are local discovery results; nothing is routed until a button is pressed. -->
 <Border x:Name="QuickStartCard" Style="{StaticResource Card}" Padding="16" BorderBrush="{DynamicResource AccentLine}"><StackPanel>
  <TextBlock Text="{l:Tr QuickStartTitle}" Style="{StaticResource SectionTitle}" FontSize="15"/>
  <TextBlock x:Name="QuickStartBody" Text="{Binding QuickStartBody}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="18" Margin="0,5,0,12" AutomationProperties.LiveSetting="Polite"/>
  <ItemsControl x:Name="QuickStartApps" ItemsSource="{Binding StarterApplications}" IsEnabled="{Binding CanEditRouting}" Visibility="{Binding HasStarterApplications, Converter={StaticResource VisibleWhen}}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Button MinHeight="50" MaxWidth="300" Padding="12,7" Margin="0,0,8,8" HorizontalContentAlignment="Left" FontFamily="{DynamicResource FontText}" Background="{DynamicResource ControlInset}" BorderBrush="{DynamicResource Border}" p:Chrome.HoverEdge="{DynamicResource AccentLine}" Command="{Binding DataContext.AddLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{l:Tr QuickStartAdd}">
     <DockPanel><Image Source="{Binding Icon}" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center"/>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" FontSize="13"/>
       <TextBlock Text="{l:Tr QuickStartAdd}" Foreground="{DynamicResource Accent}" FontFamily="{DynamicResource FontUi}" FontSize="12" FontWeight="Bold" Margin="0,2,0,0"/>
      </StackPanel>
     </DockPanel>
    </Button>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <TextBlock x:Name="QuickStartDirect" Text="{Binding QuickStartDirect}" Style="{StaticResource MutedText}" FontSize="13" LineHeight="18" Margin="0,4,0,0"/>
 </StackPanel></Border>
</UserControl>
