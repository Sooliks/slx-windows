<UserControl x:Class="Slx.Client.Desktop.Views.HelpView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation">
 <!-- Site support rail: numbered steps in glass panels, then diagnostics and contacts. -->
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" p:ScrollMemory.Key="help"><StackPanel Margin="0,8,26,22">
  <TextBlock Text="{l:Tr NavHelp}" Style="{StaticResource MonoLabel}"/><TextBlock Text="{l:Tr HelpTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{l:Tr HelpSubtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,27"/>
  <Border Style="{StaticResource Card}" Margin="0,0,0,15"><Grid><TextBlock Text="01" Style="{StaticResource StepNumber}"/><StackPanel Margin="0,0,36,0"><TextBlock Text="{l:Tr HelpReconnectTitle}" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/><TextBlock Text="{l:Tr HelpReconnectBody}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,15"><Grid><TextBlock Text="02" Style="{StaticResource StepNumber}"/><StackPanel Margin="0,0,36,0"><TextBlock Text="{l:Tr HelpAppsTitle}" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/><TextBlock Text="{l:Tr HelpAppsBody}" Style="{StaticResource MutedText}"/></StackPanel></Grid></Border>
  <Border Style="{StaticResource Card}" Margin="0,0,0,21"><Grid><TextBlock Text="03" Style="{StaticResource StepNumber}"/><StackPanel Margin="0,0,36,0"><TextBlock Text="{l:Tr HelpBindingTitle}" Style="{StaticResource PanelTitle}" Margin="0,0,0,10"/><TextBlock Text="{l:Tr HelpBindingBody}" Style="{StaticResource MutedText}"/><Button Content="{l:Tr Account}" Command="{Binding OpenAccountCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></Grid></Border>
  <v:DiagnosticsPanel Margin="0,0,0,21"/>
  <WrapPanel><Button Content="{l:Tr Support}" Command="{Binding OpenSupportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,10"/><Button Content="{l:Tr Website}" Command="{Binding OpenWebsiteCommand}" Margin="0,0,10,10"/><Button Content="{l:Tr OpenSource}" Command="{Binding OpenSourceCommand}" Margin="0,0,10,10"/></WrapPanel>
  <TextBlock Text="{l:Tr SecurityNote}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,18,0,12"/><TextBlock Text="{l:Tr AlphaNotice}" Style="{StaticResource MutedText}" FontSize="13"/>
 </StackPanel></ScrollViewer>
</UserControl>
