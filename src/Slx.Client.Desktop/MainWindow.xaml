<Window x:Class="Slx.Client.Desktop.MainWindow" x:Name="RootWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" Foreground="{DynamicResource Text}" TextElement.Foreground="{DynamicResource Text}" FontFamily="{DynamicResource FontText}" FontSize="14" FontWeight="Medium" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" Title="{l:Tr WindowTitle}" Width="1200" Height="820" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Background}" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <p:EqualValuesConverter x:Key="SameValue"/><p:CompactLayoutConverter x:Key="CompactLayout"/>
  <DataTemplate x:Key="ConnectionPage"><v:ConnectionView/></DataTemplate><DataTemplate x:Key="ApplicationsPage"><v:ApplicationsView/></DataTemplate><DataTemplate x:Key="SettingsPage"><v:SettingsView/></DataTemplate><DataTemplate x:Key="HelpPage"><v:HelpView/></DataTemplate>
  <Style x:Key="AdaptiveCaption" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="12,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource CompactLayout}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <!-- Site header navigation: interface voice, wash + accent marker for the current section. -->
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
   <Setter Property="Padding" Value="12,13"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="p:Chrome.HoverEdge" Value="{x:Null}"/>
   <Style.Triggers>
    <DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SameValue}"><Binding Path="DataContext.Page" RelativeSource="{RelativeSource Self}"/><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource AccentWash}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="AutomationProperties.ItemStatus" Value="{l:Tr CurrentPage}"/></DataTrigger>
    <DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource CompactLayout}}" Value="True"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="9,13"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="42"/><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid x:Name="CaptionRoot" Background="Transparent">
    <Border x:Name="CaptionHover" Background="{Binding Path=(p:Chrome.Hover), RelativeSource={RelativeSource TemplatedParent}}" Opacity="0" p:Motion.FadeTo="0" IsHitTestVisible="False"/>
    <Border x:Name="CaptionPress" Background="{DynamicResource ControlHighlight}" Opacity="0" p:Motion.FadeTo="0" IsHitTestVisible="False"/>
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionHover" Property="p:Motion.FadeTo" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionPress" Property="p:Motion.FadeTo" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CaptionRoot" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CaptionGlyph" TargetType="Path"><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="StrokeThickness" Value="1.2"/><Setter Property="StrokeStartLineCap" Value="Square"/><Setter Property="StrokeEndLineCap" Value="Square"/></Style>
  <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="AutomationProperties.Name" Value="{l:Tr WindowMaximize}"/><Setter Property="ToolTip" Value="{l:Tr WindowMaximize}"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, ElementName=RootWindow}" Value="Maximized"><Setter Property="AutomationProperties.Name" Value="{l:Tr WindowRestore}"/><Setter Property="ToolTip" Value="{l:Tr WindowRestore}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="MaximizeCaptionGlyph" TargetType="Path" BasedOn="{StaticResource CaptionGlyph}"><Setter Property="Data" Value="M1.5,1.5 H10.5 V10.5 H1.5 Z"/><Style.Triggers><DataTrigger Binding="{Binding WindowState, ElementName=RootWindow}" Value="Maximized"><Setter Property="Data" Value="M4,3 V1.5 H10.5 V8 H9 M1.5,4 H8 V10.5 H1.5 Z"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="p:Chrome.Hover" Value="{DynamicResource DangerWash}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Background}" IsHitTestVisible="False"/><DockPanel LastChildFill="True">
   <StackPanel x:Name="CaptionControls" DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="MinimizeCaption" Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="{l:Tr WindowMinimize}" ToolTip="{l:Tr WindowMinimize}"><Canvas Width="12" Height="12" IsHitTestVisible="False"><Path Style="{StaticResource CaptionGlyph}" Data="M1,6 H11"/></Canvas></Button>
    <Button x:Name="MaximizeCaption" Style="{StaticResource MaximizeCaptionButton}" Click="Maximize_Click"><Canvas Width="12" Height="12" IsHitTestVisible="False"><Path Style="{StaticResource MaximizeCaptionGlyph}"/></Canvas></Button>
    <Button x:Name="CloseCaption" Style="{StaticResource CloseCaptionButton}" Click="Close_Click" AutomationProperties.Name="{l:Tr WindowClose}" ToolTip="{l:Tr WindowClose}"><Canvas Width="12" Height="12" IsHitTestVisible="False"><Path Style="{StaticResource CaptionGlyph}" Data="M2,2 L10,10 M10,2 L2,10"/></Canvas></Button>
   </StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0" IsHitTestVisible="False">
    <Viewbox Width="15" Height="15"><Canvas Width="20" Height="20"><Path Fill="{DynamicResource Text}" Data="M2.5,2.5 H6.1 L17.5,17.5 H13.9 Z"/><Path Fill="{DynamicResource Accent}" Data="M17.5,2.5 H13.9 L10.6,6.9 L12.4,9.3 Z M7.6,11.6 L2.5,17.5 H6.1 L9.4,14 Z"/></Canvas></Viewbox>
    <TextBlock Text="SLX VPN" FontFamily="{DynamicResource FontUi}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,10,0"/>
    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource SmallRadius}" Padding="6,1" VerticalAlignment="Center"><TextBlock Text="Windows" FontFamily="{DynamicResource FontUi}" FontSize="12" Foreground="{DynamicResource Muted}"/></Border>
   </StackPanel>
  </DockPanel></Grid>
  <Grid Grid.Row="1" x:Name="AppContent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="Sidebar" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
    <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="204"/><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource CompactLayout}}" Value="True"><Setter Property="Width" Value="76"/></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid Margin="12,28,12,14"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" ToolTip="{Binding VersionLabel}"><Viewbox Width="30" Height="30"><Canvas Width="20" Height="20"><Path Fill="{DynamicResource Text}" Data="M2.5,2.5 H6.1 L17.5,17.5 H13.9 Z"/><Path Fill="{DynamicResource Accent}" Data="M17.5,2.5 H13.9 L10.6,6.9 L12.4,9.3 Z M7.6,11.6 L2.5,17.5 H6.1 L9.4,14 Z"/></Canvas></Viewbox><TextBlock Text="SLX" FontFamily="{DynamicResource FontUi}" FontSize="28" FontWeight="Bold" Style="{StaticResource AdaptiveCaption}"/></StackPanel>
     <StackPanel Grid.Row="1">
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="connection" AutomationProperties.Name="{l:Tr NavConnection}" ToolTip="{l:Tr NavConnection}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M8,1 V8 M4,3 A7,7 0 1 0 12,3"/><TextBlock Text="{l:Tr NavConnection}" Style="{StaticResource AdaptiveCaption}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="applications" AutomationProperties.Name="{l:Tr NavApplications}" ToolTip="{l:Tr NavApplications}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M1,1 H6 V6 H1 Z M10,1 H15 V6 H10 Z M1,10 H6 V15 H1 Z M10,10 H15 V15 H10 Z"/><TextBlock Text="{l:Tr NavApplications}" Style="{StaticResource AdaptiveCaption}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="{l:Tr NavSettings}" ToolTip="{l:Tr NavSettings}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M1,4 H15 M1,12 H15 M5,1 V7 M11,9 V15"/><TextBlock Text="{l:Tr NavSettings}" Style="{StaticResource AdaptiveCaption}"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="help" AutomationProperties.Name="{l:Tr NavHelp}" ToolTip="{l:Tr NavHelp}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M8,0 A8,8 0 1 1 7.99,0 M5.5,5 C5.5,2 11,2 11,5 C11,7 8,7 8,10 M8,12 V13"/><TextBlock Text="{l:Tr NavHelp}" Style="{StaticResource AdaptiveCaption}"/></StackPanel></Button>
     </StackPanel>
     <StackPanel Grid.Row="2">
      <Button Style="{StaticResource NavButton}" Command="{Binding OpenAccountCommand}" AutomationProperties.Name="{l:Tr Account}" ToolTip="{l:Tr Account}" FontFamily="{DynamicResource FontText}" FontSize="13"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M6,1 H1 V15 H15 V10 M9,1 H15 V7 M15,1 L7,9"/><TextBlock Text="{l:Tr Account}" Style="{StaticResource AdaptiveCaption}" TextWrapping="Wrap" MaxWidth="120"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Command="{Binding OpenSourceCommand}" AutomationProperties.Name="{l:Tr OpenSource}" ToolTip="{l:Tr OpenSource}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource FontText}" FontSize="13"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavIcon}" Data="M5,3 L0,8 5,13 M11,3 L16,8 11,13 M9,1 L7,15"/><TextBlock Text="{l:Tr OpenSource}" Style="{StaticResource AdaptiveCaption}" TextWrapping="Wrap" MaxWidth="120"/></StackPanel></Button>
      <TextBlock Text="{Binding VersionLabel}" FontFamily="{DynamicResource FontText}" Foreground="{DynamicResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="15,12,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ActualWidth, ElementName=RootWindow, Converter={StaticResource CompactLayout}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </StackPanel>
    </Grid>
   </Border>
   <p:AmbientBackdrop Grid.Column="1" IsHitTestVisible="False" RoutedApps="{Binding SelectedAppCount}" WholeRoute="{Binding IsWholeMode}"/>
   <Grid Grid.Column="1" Margin="32,25,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="MessageNotice" Style="{StaticResource Notice}" Margin="0,0,26,16" Visibility="{Binding ShowMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
    <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding}" Focusable="False"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource ConnectionPage}"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="applications"><Setter Property="ContentTemplate" Value="{StaticResource ApplicationsPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="help"><Setter Property="ContentTemplate" Value="{StaticResource HelpPage}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
   </Grid>
   <Grid x:Name="UpdateOverlayHost" Grid.Column="1" Margin="24,0,24,22" VerticalAlignment="Bottom" Panel.ZIndex="10">
    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsOverlayVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
    <v:UpdateBanner DataContext="{Binding Updates}" Width="480" MaxWidth="{Binding ActualWidth, ElementName=UpdateOverlayHost}" HorizontalAlignment="Right"/>
   </Grid>
  </Grid>
  <v:ImportOverlay Grid.RowSpan="2" x:Name="ImportPanel" Visibility="{Binding ImportVisible, Converter={StaticResource VisibleWhen}}"/>
  <Grid Grid.RowSpan="2" Background="{DynamicResource Backdrop}" Visibility="{Binding RemoveVisible, Converter={StaticResource VisibleWhen}}" KeyboardNavigation.TabNavigation="Cycle"><Border Style="{StaticResource Dialog}" Width="490" Padding="26" p:Motion.Reveal="True"><StackPanel>
   <TextBlock Text="{l:Tr ConfirmRemove}" FontFamily="{DynamicResource FontDisplay}" FontWeight="{DynamicResource DisplayWeight}" FontSize="22" Margin="0,0,0,12"/>
   <TextBlock Text="{l:Tr RemoveConfirm}" Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
   <TextBlock x:Name="RemoveBlockedNotice" Text="{l:Tr RemoveBlocked}" Foreground="{DynamicResource Danger}" FontSize="13" LineHeight="19" Margin="0,0,0,18" AutomationProperties.LiveSetting="Assertive" Visibility="{Binding RemoveBlocked, Converter={StaticResource VisibleWhen}}"/>
   <WrapPanel HorizontalAlignment="Right"><Button Content="{l:Tr Cancel}" Command="{Binding CancelOverlayCommand}" Margin="0,0,8,0"/><Button Content="{l:Tr ConfirmRemove}" Command="{Binding ConfirmRemoveCommand}" Style="{StaticResource DangerButton}"/></WrapPanel>
  </StackPanel></Border></Grid>
 </Grid>
</Window>
