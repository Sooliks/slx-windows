<Window x:Class="Slx.Client.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:l="clr-namespace:Slx.Client.Desktop.Localization" xmlns:v="clr-namespace:Slx.Client.Desktop.Views" xmlns:p="clr-namespace:Slx.Client.Desktop.Presentation" Foreground="{DynamicResource Text}" TextElement.Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14" Title="{l:Tr WindowTitle}" Width="1200" Height="820" MinWidth="940" MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" BorderBrush="{DynamicResource Border}" BorderThickness="1" Background="{DynamicResource Background}">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><p:EqualValuesConverter x:Key="SameValue"/>
  <DataTemplate x:Key="ConnectionPage"><v:ConnectionView/></DataTemplate><DataTemplate x:Key="ApplicationsPage"><v:ApplicationsView/></DataTemplate><DataTemplate x:Key="SettingsPage"><v:SettingsView/></DataTemplate><DataTemplate x:Key="HelpPage"><v:HelpView/></DataTemplate>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource LinkButton}"><Setter Property="Padding" Value="14,13"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Style.Triggers><DataTrigger Value="True"><DataTrigger.Binding><MultiBinding Converter="{StaticResource SameValue}"><Binding Path="DataContext.Page" RelativeSource="{RelativeSource Self}"/><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding><Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Background}"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="—" Width="46" MinHeight="32" Padding="0" Style="{StaticResource LinkButton}" Click="Minimize_Click" AutomationProperties.Name="{l:Tr WindowMinimize}" ToolTip="{l:Tr WindowMinimize}"/>
    <Button Content="□" Width="46" MinHeight="32" Padding="0" Style="{StaticResource LinkButton}" Click="Maximize_Click" AutomationProperties.Name="{l:Tr WindowMaximize}" ToolTip="{l:Tr WindowMaximize}"/>
    <Button Content="×" Width="46" MinHeight="32" Padding="0" Style="{StaticResource LinkButton}" Click="Close_Click" AutomationProperties.Name="{l:Tr WindowClose}" ToolTip="{l:Tr WindowClose}"/>
   </StackPanel>
   <TextBlock Text="SLX VPN" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="22,0" Foreground="{DynamicResource Muted}"/>
  </DockPanel></Border>
  <Grid Grid.Row="1" x:Name="AppContent"><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><Grid Margin="16,28,16,14"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Top"><Viewbox Width="31" Height="31" Margin="0,0,10,0"><Canvas Width="40" Height="40"><Path Fill="{DynamicResource Text}" Data="M 2,3 L 12,3 24,21 19,29 Z M 26,3 L 38,3 25,20 20,13 Z M 20,28 L 25,22 38,38 27,38 Z M 14,23 L 20,32 15,38 3,38 Z"/></Canvas></Viewbox><TextBlock Text="SLX" FontFamily="Consolas" FontSize="30" FontWeight="Bold"/></StackPanel>
    <StackPanel Grid.Row="1">
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="connection"><TextBlock Text="{l:Tr NavConnection}"/></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="applications"><TextBlock Text="{l:Tr NavApplications}"/></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="settings"><TextBlock Text="{l:Tr NavSettings}"/></Button>
     <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="help"><TextBlock Text="{l:Tr NavHelp}"/></Button>
    </StackPanel>
    <StackPanel Grid.Row="2"><Button Style="{StaticResource LinkButton}" Command="{Binding OpenAccountCommand}"><TextBlock Text="{l:Tr Account}" FontSize="12"/></Button><Button Style="{StaticResource LinkButton}" Command="{Binding OpenSourceCommand}"><TextBlock Text="{l:Tr OpenSource}" Foreground="{DynamicResource Muted}" FontSize="11"/></Button><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource MonoLabel}" FontSize="9" Margin="0,12,0,0"/></StackPanel>
   </Grid></Border>
   <p:AmbientBackdrop Grid.Column="1" IsHitTestVisible="False"/>
   <Grid Grid.Column="1" Margin="38,25,38,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Margin="0,0,0,16" Padding="14,10" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Visibility="{Binding ShowMessage, Converter={StaticResource VisibleWhen}}"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></Border>
    <ContentControl Grid.Row="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource ConnectionPage}"/><Style.Triggers><DataTrigger Binding="{Binding Page}" Value="applications"><Setter Property="ContentTemplate" Value="{StaticResource ApplicationsPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="settings"><Setter Property="ContentTemplate" Value="{StaticResource SettingsPage}"/></DataTrigger><DataTrigger Binding="{Binding Page}" Value="help"><Setter Property="ContentTemplate" Value="{StaticResource HelpPage}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
   </Grid>
  </Grid>
  <v:ImportOverlay Grid.RowSpan="2" x:Name="ImportPanel" Visibility="{Binding ImportVisible, Converter={StaticResource VisibleWhen}}"/>

  <Grid Grid.RowSpan="2" Background="#C90B0D09" Visibility="{Binding RemoveVisible, Converter={StaticResource VisibleWhen}}" KeyboardNavigation.TabNavigation="Cycle"><Border Style="{StaticResource Card}" Width="490" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><TextBlock Text="{l:Tr RemoveConfirm}" FontSize="18" Margin="0,0,0,24"/><WrapPanel HorizontalAlignment="Right"><Button Content="{l:Tr Cancel}" Command="{Binding CancelOverlayCommand}" Margin="0,0,8,0"/><Button Content="{l:Tr ConfirmRemove}" Command="{Binding ConfirmRemoveCommand}" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Border></Grid>
 </Grid>
</Window>
