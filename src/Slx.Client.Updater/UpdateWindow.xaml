<Window x:Class="Slx.Client.Updater.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="SLX VPN" Width="530" Height="480" MinWidth="440" MinHeight="440" ResizeMode="CanMinimize" WindowStyle="None" WindowStartupLocation="CenterScreen"
    Background="{DynamicResource UpdateCanvas}" Foreground="{DynamicResource UpdateText}" FontFamily="Segoe UI" FontSize="14" FontWeight="Medium" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="UpdateCanvas" Color="#10120E"/><SolidColorBrush x:Key="UpdateSurface" Color="#191D16"/>
        <SolidColorBrush x:Key="UpdateSurfaceHover" Color="#252C1E"/><SolidColorBrush x:Key="UpdateBorder" Color="#343B2B"/>
        <SolidColorBrush x:Key="UpdateText" Color="#F1F3E9"/><SolidColorBrush x:Key="UpdateMuted" Color="#B9BFAF"/>
        <SolidColorBrush x:Key="UpdateAccent" Color="#DFEF4B"/><SolidColorBrush x:Key="UpdateAccentHover" Color="#EDF77A"/>
        <SolidColorBrush x:Key="UpdateAccentText" Color="#10120E"/><SolidColorBrush x:Key="UpdateDanger" Color="#762F32"/>
        <Style x:Key="UpdateFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-3" BorderBrush="{DynamicResource UpdateAccent}" BorderThickness="2" CornerRadius="8"/></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="UpdateButton" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource UpdateSurface}"/><Setter Property="Foreground" Value="{DynamicResource UpdateText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UpdateBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{StaticResource UpdateFocus}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource UpdateSurfaceHover}"/><Setter Property="BorderBrush" Value="{DynamicResource UpdateAccent}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="UpdatePrimary" TargetType="Button" BasedOn="{StaticResource UpdateButton}">
            <Setter Property="Background" Value="{DynamicResource UpdateAccent}"/><Setter Property="Foreground" Value="{DynamicResource UpdateAccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource UpdateAccent}"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource UpdateAccentHover}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="UpdateCaption" TargetType="Button" BasedOn="{StaticResource UpdateButton}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
        <Style x:Key="UpdateCloseCaption" TargetType="Button" BasedOn="{StaticResource UpdateCaption}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource UpdateDanger}"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource UpdateBorder}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource UpdateBorder}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,3,3,3">
                        <Button x:Name="MinimizeCaption" Style="{StaticResource UpdateCaption}" Click="Minimize"><Path Data="M2,6 H12" Width="14" Height="14" Stretch="None" Stroke="{DynamicResource UpdateText}" StrokeThickness="1.2"/></Button>
                        <Button x:Name="CloseCaption" Style="{StaticResource UpdateCloseCaption}" Click="CloseWindow"><Path Data="M3,3 L11,11 M11,3 L3,11" Width="14" Height="14" Stretch="None" Stroke="{DynamicResource UpdateText}" StrokeThickness="1.2"/></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False">
                        <Viewbox Width="23" Height="23"><Canvas Width="20" Height="20"><Path Fill="{DynamicResource UpdateText}" Data="M2.5,2.5 H6.1 L17.5,17.5 H13.9 Z"/><Path Fill="{DynamicResource UpdateAccent}" Data="M17.5,2.5 H13.9 L10.6,6.9 L12.4,9.3 Z M7.6,11.6 L2.5,17.5 H6.1 L9.4,14 Z"/></Canvas></Viewbox>
                        <TextBlock Text="SLX VPN" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="26,23,26,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="VersionCaption" FontSize="13" Foreground="{DynamicResource UpdateAccent}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Heading" Margin="0,10,0,0" MinHeight="62" FontSize="24" LineHeight="30" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <TextBlock x:Name="Description" Grid.Row="1" MinHeight="68" Margin="0,0,0,8" Foreground="{DynamicResource UpdateMuted}" LineHeight="22" TextWrapping="Wrap"/>
                <Border Grid.Row="2" Background="{DynamicResource UpdateSurface}" BorderBrush="{DynamicResource UpdateBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,8,0,16" MinHeight="86">
                    <StackPanel VerticalAlignment="Center">
                        <ProgressBar x:Name="Activity" Height="4" IsIndeterminate="True" Foreground="{DynamicResource UpdateAccent}" Background="{DynamicResource UpdateBorder}" BorderThickness="0"/>
                        <TextBlock x:Name="Detail" FontSize="13" Foreground="{DynamicResource UpdateMuted}" Margin="0,11,0,0" LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <WrapPanel Grid.Row="3" MinHeight="44" HorizontalAlignment="Right">
                    <Button x:Name="RetryButton" Style="{StaticResource UpdateButton}" Click="Retry" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="ReturnButton" Style="{StaticResource UpdatePrimary}" Click="Return" Visibility="Collapsed"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
